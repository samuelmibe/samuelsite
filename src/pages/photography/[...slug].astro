---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photography/**/*.{jpeg,jpg,png,JPEG,JPG,PNG}',
  { eager: true }
);

function imagesFor(id: string) {
  return Object.entries(allImages)
    .filter(([path]) => path.includes(`/photography/${id}/`))
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);
}

export async function getStaticPaths() {
  const collections = await getCollection('photography');
  return collections.map((c) => ({
    params: { slug: c.id },
    props: { collection: c },
  }));
}

const { collection } = Astro.props;
const { title, description, titles } = collection.data;
const photos = imagesFor(collection.id);
const captionFor = (i: number) => titles[i] ?? `${title} — ${i + 1}`;
const { Content } = await render(collection);
---

<BaseLayout title={title} description={description || title}>
  <section class="wrap wrap--wide intro">
    <p class="back"><a href="/photography">&larr; photography</a></p>
    <h1>{title}</h1>
    <div class="statement">
      <Content />
    </div>
  </section>

  {photos.length === 0 ? (
    <section class="wrap wrap--wide"><p class="muted">Photos coming soon.</p></section>
  ) : (
    <section class="wrap wrap--wide carousel" data-carousel>
      <div class="carousel__frame">
        <button class="carousel__nav carousel__prev" aria-label="Previous photo">&#8249;</button>
        <div class="carousel__stage">
          {photos.map((photo, i) => (
            <Image
              class:list={['carousel__slide', { 'is-active': i === 0 }]}
              src={photo}
              alt={captionFor(i)}
              data-caption={captionFor(i)}
              widths={[480, 800, 1200, 1600]}
              sizes="(max-width: 60rem) 92vw, 56rem"
              format="webp"
              quality={80}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
        <button class="carousel__nav carousel__next" aria-label="Next photo">&#8250;</button>
      </div>
      <p class="carousel__caption">{captionFor(0)}</p>
      <p class="carousel__counter muted">1 / {photos.length}</p>
    </section>
  )}
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('.carousel__slide')
    );
    const caption = root.querySelector<HTMLElement>('.carousel__caption')!;
    const counter = root.querySelector<HTMLElement>('.carousel__counter')!;
    let idx = 0;

    function update() {
      slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));
      caption.textContent = slides[idx].dataset.caption || '';
      counter.textContent = `${idx + 1} / ${slides.length}`;
    }
    function go(delta: number) {
      idx = (idx + delta + slides.length) % slides.length;
      update();
    }

    root.querySelector('.carousel__prev')!.addEventListener('click', () => go(-1));
    root.querySelector('.carousel__next')!.addEventListener('click', () => go(1));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });

    // Basic touch swipe.
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
</script>

<style>
  .intro {
    padding-block: var(--space-4) var(--space-3);
  }

  .back {
    margin-bottom: var(--space-2);
  }

  .back a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .statement {
    max-width: 44rem;
    margin-top: var(--space-3);
  }

  .statement :global(p) {
    margin: 0 0 var(--space-2);
  }

  .statement :global(p:last-child) {
    margin-bottom: 0;
  }

  .carousel {
    padding-block: var(--space-4) var(--space-5);
  }

  .carousel__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 3.5rem;
  }

  .carousel__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40vh;
  }

  .carousel__slide {
    display: none;
    max-width: 100%;
    max-height: 74vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    border-radius: 0.25rem;
  }

  .carousel__slide.is-active {
    display: block;
  }

  .carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: none;
    border: 0;
    color: var(--color-text);
    font-size: 3rem;
    line-height: 1;
    padding: var(--space-2);
    cursor: pointer;
  }

  .carousel__nav:hover {
    color: var(--color-accent);
  }

  .carousel__prev {
    left: 0;
  }

  .carousel__next {
    right: 0;
  }

  .carousel__caption {
    text-align: center;
    margin: var(--space-3) 0 var(--space-1);
    text-transform: lowercase;
  }

  .carousel__counter {
    text-align: center;
    font-size: 0.85rem;
    margin: 0;
  }

  @media (max-width: 40rem) {
    .carousel__frame {
      padding-inline: 2rem;
    }

    .carousel__nav {
      font-size: 2.25rem;
      padding: var(--space-1);
    }
  }
</style>
