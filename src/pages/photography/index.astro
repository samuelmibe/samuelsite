---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photography/**/*.{jpeg,jpg,png,JPEG,JPG,PNG}',
  { eager: true }
);

function coverFor(id: string) {
  const entry = Object.entries(allImages)
    .filter(([path]) => path.includes(`/photography/${id}/`))
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))[0];
  return entry ? entry[1].default : null;
}

const collections = (await getCollection('photography')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Photography" description="A photography portfolio.">
  <section class="wrap wrap--wide intro">
    <h1>photography</h1>
    <p class="muted">a selection of past series, collections</p>
  </section>

  <section class="wrap wrap--wide collections">
    {collections.length === 0 && <p class="muted">Nothing here yet.</p>}
    {collections.map((c) => {
      const cover = coverFor(c.id);
      return (
        <a class="collection" href={`/photography/${c.id}/`}>
          {cover ? (
            <Image
              class="collection__cover"
              src={cover}
              alt={c.data.title}
              widths={[400, 800]}
              sizes="(max-width: 40rem) 100vw, 32rem"
              format="webp"
              quality={80}
              loading="lazy"
            />
          ) : (
            <div class="collection__cover collection__cover--placeholder"></div>
          )}
          <h2 class="collection__title">{c.data.title}</h2>
        </a>
      );
    })}
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-5) var(--space-4);
  }

  .collections {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .collection {
    text-decoration: none;
    display: block;
  }

  .collection__cover {
    aspect-ratio: 3 / 2;
    width: 100%;
    object-fit: cover;
    border-radius: 0.25rem;
    margin-bottom: var(--space-2);
  }

  .collection__cover--placeholder {
    background: linear-gradient(155deg, var(--color-border), var(--color-bg));
  }

  .collection__title {
    font-size: 1.15rem;
    margin: 0;
  }

  .collection:hover .collection__title {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .collections {
      grid-template-columns: 1fr;
    }
  }
</style>
