---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import photo from '../assets/samuel-mainpage-home.jpeg';

const [nowEntry] = await getCollection('now');
const { Content } = nowEntry ? await render(nowEntry) : { Content: null };

const [interestsEntry] = await getCollection('interests');
const { Content: InterestsContent } = interestsEntry
  ? await render(interestsEntry)
  : { Content: null };
---

<BaseLayout>
  <section class="wrap wrap--wide hero">
    <Image src={photo} alt="Samuel" class="hero__photo" width={822} height={652} loading="eager" />
    <p class="hero__intro muted">Hello! I am Samuel Minev-Benzecry, a recent graduate of Stanford University, where I double majored in Earth Systems and Linguistics, minored in History, and received Honors in the Arts. I am currently pursuing my Master's in Earth Systems, also at Stanford, with a focus on Agroforestry. This summer, I am based in Manaus, Brazil, where I am doing research for my thesis, working on language inclusion projects, and catching up on reading and organization of personal files and objects. Always an email away!</p>
  </section>

  {(InterestsContent || Content) && (
    <section class="wrap wrap--wide now">
      <div class="now-grid">
        {InterestsContent && (
          <div class="now-col">
            <h2>general interests</h2>
            <div class="now__content">
              <InterestsContent />
            </div>
          </div>
        )}

        {Content && (
          <div class="now-col">
            <h2>current fascinations</h2>
            <div class="now__content">
              <Content />
            </div>
            <p class="now__updated muted">
              Updated {nowEntry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </p>
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-4);
  }

  .hero__photo {
    width: 20rem;
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .hero__intro {
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: min(38rem, 100%);
    margin: 0;
  }

  @media (max-width: 40rem) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .now {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .now-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  @media (max-width: 40rem) {
    .now-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  .now__content :global(p:last-child),
  .now__content :global(ul:last-child) {
    margin-bottom: 0;
  }

  .now__content :global(li) {
    margin-bottom: 0.35em;
  }

  .now__updated {
    font-size: 0.85rem;
    margin-top: var(--space-2);
    margin-bottom: 0;
  }
</style>
